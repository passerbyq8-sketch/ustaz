# Al-Murabbi - line-ending pins.
# Defect 40, MEASURED in session 28: a fresh clone with core.autocrlf=true injects
# 77 CR into worship-golden.json (SHA8 A13C34BA -> F48CB7C7) and 55 CR into
# worship-display.json (64B8A2C9 -> 9A56CC5B), and gate 7 exits 1.

# Byte-compared or SHA-pinned by the guards. LF forever, on every machine.
worship-golden.json      text eol=lf
worship-display.json     text eol=lf
quran-golden.json        text eol=lf
referral-golden.json     text eol=lf
adhkar.json              text eol=lf
lib/data/adhkar.json     text eol=lf

# recon-audit requires bare-LF = 0 inside index.html. Pure CRLF, on every machine.
index.html               text eol=crlf

# Not measured by any guard. Pinned only so every machine agrees -- and so the local
# bytes match what git stores and Vercel serves, which is LF for both today.
privacy.html             text eol=lf
sw.js                    text eol=lf
.gitattributes           text eol=lf

# D09, MEASURED: sw.js and manifest.json are BOTH SHA-256 sealed now, by gate
# `bankintegrity` (check B10), and the seal is cut on LF bytes -- so the note above
# ("not measured by any guard") no longer holds for either of them. manifest.json
# carried no pin at all, so a clone with core.autocrlf=true checked it out with 16 CR
# (533 -> 549 bytes) and the seal broke on a machine that had changed nothing. sw.js
# was pinned on line 20 already but had drifted to CRLF in the working tree (4944 ->
# 5044) and the seal had been cut on those CRLF bytes, which is the same defect from
# the other end: it held on this machine and nowhere else.
manifest.json            text eol=lf

# Zero-newline by design (gate 5 depends on it). Git must never rewrap these.
quran-uthmani.json       -text
mushaf-layout.json       -text

# Binary. Never convert.
*.gz                     binary
quest-data/*.json -text

