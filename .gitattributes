# Al-Murabbi - line-ending pins.
# Defect 40, MEASURED in session 28: a fresh clone with core.autocrlf=true injects
# 77 CR into worship-golden.json (SHA8 A13C34BA -> F48CB7C7) and 55 CR into
# worship-display.json (64B8A2C9 -> 9A56CC5B), and gate 7 exits 1.

# Byte-compared or SHA-pinned by the guards. LF forever, on every machine.
worship-golden.json      text eol=lf
worship-display.json     text eol=lf
quran-golden.json        text eol=lf
referral-golden.json     text eol=lf
adhkar.json              text eol=lf
lib/data/adhkar.json     text eol=lf

# recon-audit requires bare-LF = 0 inside index.html. Pure CRLF, on every machine.
index.html               text eol=crlf

# Not measured by any guard. Pinned only so every machine agrees -- and so the local
# bytes match what git stores and Vercel serves, which is LF for both today.
privacy.html             text eol=lf
sw.js                    text eol=lf
.gitattributes           text eol=lf

# Zero-newline by design (gate 5 depends on it). Git must never rewrap these.
quran-uthmani.json       -text
mushaf-layout.json       -text

# Binary. Never convert.
*.gz                     binary
quest-data/*.json -text

# Defect 40 extended: these nine guard scripts were brought under git tracking in
# bug 43. Pin them to LF so a fresh clone with core.autocrlf=true cannot inject CR
# into them (a CR shift would corrupt the byte counts the guards measure).
worship-guard.cjs         text eol=lf
quran-guard.cjs           text eol=lf
layout-guard.cjs          text eol=lf
babel-gate.cjs            text eol=lf
runtime-gate.cjs          text eol=lf
recon-audit.cjs           text eol=lf
build-worship-display.cjs text eol=lf
referral-guard.cjs        text eol=lf
classifier-guard.cjs      text eol=lf
gates.json text eol=lf

# Gate 10 (hafs-map-guard) and the correspondence map it SHA-pins. Defect 40 again:
# the map's sha256 is asserted by the gate, so a fresh clone with core.autocrlf=true
# would inject CR, move the hash and fail the gate on a machine that changed nothing.
hafs-map-guard.cjs        text eol=lf
data/mushaf-hafs-map.json text eol=lf
build-golden-md.cjs text eol=lf
build-mushaf-layout.cjs text eol=lf
esc.cjs text eol=lf
flip-stream-flag.cjs text eol=lf
quran-verify.cjs text eol=lf
lib/daycap.js text eol=lf
api/unlock.js text eol=crlf

# Gate 11 (call-mode-guard). Same reason as every gate above: it brace-slices index.html,
# so a clone that injected CR into the GATE itself would shift nothing -- but a gate that
# is not LF-pinned is the one file in the roster whose bytes nobody agrees on.
call-mode-guard.cjs text eol=lf

# Gate 12 (chat-history-guard). Same reason as every gate above.
chat-history-guard.cjs text eol=lf

# Gate 13 (markdown-guard). Same reason as every gate above.
markdown-guard.cjs text eol=lf

# Gate 14 (quest-reveal-guard). Same reason as every gate above. Its golden lives under
# quest-data/, already covered by the "quest-data/*.json -text" rule further up.
quest-reveal-guard.cjs text eol=lf

# Gate 15 (quran-quest-guard). Same reason as every gate above. Its golden also lives
# under quest-data/, covered by the "quest-data/*.json -text" rule further up.
quran-quest-guard.cjs text eol=lf

# Gate 16 (prayer-quest-guard). Same reason as every gate above. Its golden also lives
# under quest-data/, covered by the "quest-data/*.json -text" rule further up.
prayer-quest-guard.cjs text eol=lf

# Gate 17 (quest-bank-integrity-guard). Same reason as every gate above. Its golden also
# lives under quest-data/, covered by the "quest-data/*.json -text" rule further up.
quest-bank-integrity-guard.cjs text eol=lf

# Gate 18 (quest-content-review-guard). Same reason as every gate above. Its manifest also
# lives under quest-data/, covered by the "quest-data/*.json -text" rule further up.
quest-content-review-guard.cjs text eol=lf

# Gate 19 (theme-coverage-guard). Same reason as every gate above: it is compared byte-for-byte
# against what the app ships, so its own line endings must not drift under core.autocrlf.
theme-coverage-guard.cjs text eol=lf

# Gate 20 (chat-ux-guard). Same reason as every gate above: it reads and re-runs the shipped
# babel block, so its own line endings must not drift under core.autocrlf.
chat-ux-guard.cjs text eol=lf

# Gate 21 (a11y-guard). Same reason as every gate above: it re-runs the shipped babel block, so
# its own line endings must not drift under core.autocrlf.
a11y-guard.cjs text eol=lf

# Gate 22 (quest-ux-guard). It seals the question bank by hash and drives the shipped page in a
# real browser, so its own line endings must not drift under core.autocrlf.
quest-ux-guard.cjs text eol=lf

# Gate 23 (attribution-guard). Same reason as every gate above. Its two modules are pinned for
# the same reason lib/daycap.js is: the gate reads them as text and asserts on their contents, so
# a fresh clone with core.autocrlf=true must not shift a byte of them.
attribution-guard.cjs text eol=lf
lib/attribution.js text eol=lf
lib/binothaimeen.js text eol=lf

# Gate 24 (claim-guard) and the two captured islamweb pages it measures against. Same reason as
# every gate above: the fixtures are matched as text, so a CR injected by core.autocrlf would
# change what the gate is comparing.
claim-guard.cjs text eol=lf
data/claim-fixtures.json text eol=lf
lib/claim-gate.js text eol=lf
lib/duration.js text eol=lf

# Gate 25 (source-registry-guard) and the three modules it asserts on. Same reason as every
# gate above: the guard reads these files as text and matches on their contents, so a CR
# injected by core.autocrlf on a fresh clone must not shift a byte of them.
source-registry-guard.cjs text eol=lf
lib/source-registry.js text eol=lf
lib/source-purpose.js text eol=lf
lib/source-page-gates.js text eol=lf
lib/retrieve.js text eol=lf
tools/source-live-smoke.cjs text eol=lf

# Gate 26 (brave-query-guard) and the query builder it measures. Same reason as every gate
# above: the guard reads these files as text and asserts on their contents.
brave-query-guard.cjs text eol=lf
lib/brave-query.js text eol=lf

# Gate 27 (smart-retrieval-guard) and the request planner it measures.
smart-retrieval-guard.cjs text eol=lf
lib/ask-plan.js text eol=lf
api/ask.js text eol=lf

# Gates 28-32 (the ledger-RAG guards) and every module they read as text. Same reason as every
# gate above, and one more that is specific to this path: lib/ledger/segment.js records UTF-8
# BYTE offsets into page text, and lib/ledger/gates.js re-derives every span from them. A CR
# injected by core.autocrlf on a fresh clone would shift those offsets and turn a correct
# extraction into a failing Gate 1 on a machine that changed nothing.
ledger-contract-guard.cjs text eol=lf
ledger-retrieval-guard.cjs text eol=lf
ledger-gates-guard.cjs text eol=lf
ledger-runtime-guard.cjs text eol=lf
ledger-fixtures-guard.cjs text eol=lf
ledger-seam-guard.cjs text eol=lf
data/ledger-fixtures.json text eol=lf
data/ledger-fixture-results.json text eol=lf
tools/ledger-live-eval.cjs text eol=lf
lib/ledger/*.js text eol=lf

# Gates 34-35 (the RFC v0.5-R2 policy guards) and the shared policy core they measure. Same
# reason as every gate above, and one specific to this batch: lib/policy/entities.js and
# lib/policy/age.js match Arabic on WHOLE-WORD boundaries, and a CR injected by core.autocrlf on a
# fresh clone would sit inside a word run and change what those boundaries see.
guards/rfc-v05r2-guard.cjs text eol=lf
guards/rfc-v05r2-runtime-guard.cjs text eol=lf
guards/rfc-v05r2-wiring-guard.cjs text eol=lf
guards/rfc-v05r2-round3-guard.cjs text eol=lf
guards/rfc-v05r2-mode-guard.cjs text eol=lf
guards/rfc-v05r2-historical-guard.cjs text eol=lf
guards/rfc-v05r2-consistency-guard.cjs text eol=lf
lib/policy/*.js text eol=lf
lib/legacy-policy-flag.js text eol=lf
guards/rfc-v05r2-entity-world-guard.cjs text eol=lf
