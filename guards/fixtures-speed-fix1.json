  "q16": "\u0645\u0627 \u0627\u0644\u0623\u0630\u0643\u0627\u0631 \u0627\u0644\u062b\u0627\u0628\u062a\u0629 \u0628\u0639\u062f \u0627\u0644\u0635\u0644\u0627\u0629 \u0627\u0644\u0645\u0643\u062a\u0648\u0628\u0629\u061f",
  "a16": [
    "\u0644\u0645 \u0623\u062c\u062f \u0641\u064a \u0645\u0635\u0627\u062f\u0631 \u0639\u0632\u0643 \u0646\u0635\u0627 \u064a\u062c\u064a\u0628 \u0639\u0646 \u0647\u0630\u0647 \u0627\u0644\u0645\u0633\u0623\u0644\u0629 \u0628\u0639\u064a\u0646\u0647\u0627.",
    "\u0644\u0645 \u0623\u062c\u062f \u0641\u064a \u0645\u0635\u0627\u062f\u0631 \u0639\u0632\u0643 \u0646\u0635\u0627 \u064a\u062c\u064a\u0628 \u0639\u0646 \u0647\u0630\u0647 \u0627\u0644\u0645\u0633\u0623\u0644\u0629 \u0628\u0639\u064a\u0646\u0647\u0627."
  ],
  "q9": "\u062a\u0648\u0641\u064a \u0631\u062c\u0644 \u0648\u062a\u0631\u0643 \u0632\u0648\u062c\u0629 \u0648\u0623\u0645\u064b\u0651\u0627 \u0648\u0627\u0628\u0646\u064b\u0627 \u0648\u0628\u0646\u062a\u064a\u0646\u060c \u0643\u064a\u0641 \u062a\u0642\u0633\u0645 \u0627\u0644\u062a\u0631\u0643\u0629\u061f",
  "a9": [
    "\u0644\u0645 \u0623\u062c\u062f \u0641\u064a \u0645\u0635\u0627\u062f\u0631 \u0639\u0632\u0643 \u0646\u0635\u0627 \u064a\u062c\u064a\u0628 \u0639\u0646 \u0647\u0630\u0647 \u0627\u0644\u0645\u0633\u0623\u0644\u0629 \u0628\u0639\u064a\u0646\u0647\u0627.",
    "\u0627\u0644\u0646\u0635 \u0627\u0644\u0645\u062a\u0627\u062d \u0639\u0646\u062f\u064a \u064a\u062a\u062d\u062f\u062b \u0639\u0646 \u0645\u0633\u0623\u0644\u0629 \u0645\u062e\u062a\u0644\u0641\u0629: \u0632\u0648\u062c\u0629 \u0648\u0628\u0646\u062a\u064a\u0646 \u0648\u0623\u062e \u0645\u0646 \u0627\u0644\u0623\u0645\u060c \u0648\u0644\u064a\u0633 \u0641\u064a\u0647 \u0630\u0643\u0631 \u0644\u0623\u0645 \u0648\u0644\u0627 \u0644\u0627\u0628\u0646 \u0630\u0643\u0631 \u0636\u0645\u0646 \u0627\u0644\u0648\u0631\u062b\u0629 \u0643\u0645\u0627 \u0641\u064a \u0633\u0624\u0627\u0644\u0643. \u0641\u0645\u0633\u0623\u0644\u062a\u0643 \u062a\u062d\u0648\u064a \u0648\u0627\u0631\u062b\u0627 \u0630\u0643\u0631\u0627 \u0645\u0646 \u0627\u0644\u0641\u0631\u0639 (\u0627\u0628\u0646) \u0648\u0623\u0645\u0627 \u0644\u0644\u0645\u064a\u062a\u060c \u0648\u0647\u0624\u0644\u0627\u0621 \u0644\u0645 \u064a\u0631\u062f\u0648\u0627 \u0641\u064a \u0627\u0644\u0646\u0635\u060c \u0641\u0644\u0627 \u064a\u0635\u062d \u0623\u0646 \u0623\u0628\u0646\u064a \u0639\u0644\u064a\u0647 \u0642\u0633\u0645\u0629 \u0644\u0645\u0633\u0623\u0644\u0629 \u062a\u062e\u062a\u0644\u0641 \u0639\u0646\u0647 \u0641\u064a \u0623\u0635\u0644 \u0627\u0644\u0648\u0631\u062b\u0629."
  ],
  "q4": "\u0645\u0627 \u062d\u0643\u0645 \u0645\u0646 \u062a\u0631\u0643 \u0627\u0644\u0645\u0628\u064a\u062a \u0628\u0645\u0646\u0649 \u0623\u064a\u0627\u0645 \u0627\u0644\u062a\u0634\u0631\u064a\u0642 \u0628\u0644\u0627 \u0639\u0630\u0631\u061f",
  "a4": [
    "\u0627\u0639\u062a\u0628\u0631 \u0627\u0644\u0645\u0628\u064a\u062a \u0628\u0645\u0646\u0649 \u0623\u064a\u0627\u0645 \u0627\u0644\u062a\u0634\u0631\u064a\u0642 \u0645\u0646 \u0648\u0627\u062c\u0628\u0627\u062a \u0627\u0644\u062d\u062c \u0641\u064a \u0623\u0635\u062d \u0642\u0648\u0644\u064a \u0623\u0647\u0644 \u0627\u0644\u0639\u0644\u0645\u060c \u0648\u0645\u0646 \u062a\u0631\u0643\u0647 \u0628\u062f\u0648\u0646 \u0639\u0630\u0631 \u0634\u0631\u0639\u064a \u0641\u0639\u0644\u064a\u0647 \u062f\u0645\u061b \u0644\u0645\u0627 \u062b\u0628\u062a \u0639\u0646 \u0627\u0628\u0646 \u0639\u0628\u0627\u0633 \u0631\u0636\u064a \u0627\u0644\u0644\u0647 \u0639\u0646\u0647\u0645\u0627 \u0623\u0646\u0647 \u0642\u0627\u0644: \u0645\u0646 \u062a\u0631\u0643 \u0646\u0633\u0643\u0627 \u0623\u0648 \u0646\u0633\u064a\u0647 \u0641\u0644\u064a\u0647\u0631\u0642 \u062f\u0645\u0627\u060c \u0648\u064a\u0643\u0641\u064a\u0647 \u062f\u0645 \u0648\u0627\u062d\u062f \u0639\u0646 \u062a\u0631\u0643 \u0627\u0644\u0645\u0628\u064a\u062a \u0623\u064a\u0627\u0645 \u0627\u0644\u062a\u0634\u0631\u064a\u0642.",
    "\u064a\u0633\u0642\u0637 \u0627\u0644\u0645\u0628\u064a\u062a \u0628\u0645\u0646\u0649 \u0639\u0646 \u0630\u0648\u064a \u0627\u0644\u0623\u0639\u0630\u0627\u0631 \u0643\u0623\u0647\u0644 \u0627\u0644\u0633\u0642\u0627\u064a\u0629 \u0648\u0631\u0639\u0627\u0621 \u0627\u0644\u0625\u0628\u0644 \u0648\u0627\u0644\u0645\u0631\u0636\u0649 \u0648\u0645\u0646 \u0641\u064a \u062d\u0643\u0645\u0647\u0645. \u0641\u0625\u0630\u0627 \u0644\u0645 \u064a\u0633\u062a\u0637\u0639 \u0627\u0644\u062d\u0627\u062c \u0627\u0644\u0645\u0628\u064a\u062a \u0641\u064a \u0645\u0646\u0649 \u0623\u064a\u0627\u0645 \u0627\u0644\u062a\u0634\u0631\u064a\u0642 \u0641\u0644\u0627 \u0634\u064a\u0621 \u0639\u0644\u064a\u0647\u061b \u0644\u0642\u0648\u0644 \u0627\u0644\u0644\u0647 \u0633\u0628\u062d\u0627\u0646\u0647 \u0648\u062a\u0639\u0627\u0644\u0649: \u0641\u0627\u062a\u0642\u0648\u0627 \u0627\u0644\u0644\u0647 \u0645\u0627 \u0627\u0633\u062a\u0637\u0639\u062a\u0645\u060c \u0633\u0648\u0627\u0621 \u0643\u0627\u0646 \u062a\u0631\u0643 \u0627\u0644\u0645\u0628\u064a\u062a \u0644\u0645\u0631\u0636\u060c \u0623\u0648 \u0639\u062f\u0645 \u0648\u062c\u0648\u062f \u0645\u0643\u0627\u0646\u060c \u0623\u0648 \u0646\u062d\u0648\u0647\u0645\u0627 \u0645\u0646 \u0627\u0644\u0623\u0639\u0630\u0627\u0631 \u0627\u0644\u0634\u0631\u0639\u064a\u0629\u060c \u0643\u0627\u0644\u0633\u0642\u0627\u0629 \u0648\u0627\u0644\u0631\u0639\u0627\u0629 \u0648\u0645\u0646 \u0641\u064a \u062d\u0643\u0645\u0647\u0645\u0627.",
    "\u0644\u0645 \u0623\u062c\u062f \u0641\u064a \u0645\u0635\u0627\u062f\u0631 \u0639\u0632\u0643 \u0646\u0635\u0627 \u064a\u062c\u064a\u0628 \u0639\u0646 \u0647\u0630\u0647 \u0627\u0644\u0645\u0633\u0623\u0644\u0629 \u0628\u0639\u064a\u0646\u0647\u0627."
  ],
  "q11": "\u0623\u064a\u0646 \u0648\u0631\u062f \u062d\u062f\u064a\u062b: \u0627\u0644\u062f\u064a\u0646 \u0627\u0644\u0646\u0635\u064a\u062d\u0629\u061f \u0648\u0645\u0646 \u0631\u0648\u0627\u0647\u061f",
  "a11": [
    "\u0642\u0627\u0644: \u00ab\u0644\u0644\u0647\u060c \u0648\u0644\u0643\u062a\u0627\u0628\u0647\u060c \u0648\u0644\u0631\u0633\u0648\u0644\u0647\u060c \u0648\u0644\u0623\u0626\u0645\u0629 \u0627\u0644\u0645\u0633\u0644\u0645\u064a\u0646\u060c \u0648\u0639\u0627\u0645\u062a\u0647\u0645\u00bb.",
    "\u0648\u0642\u062f \u0648\u0631\u062f \u0623\u064a\u0636\u0627 \u0639\u0646\u062f \u0627\u0644\u062a\u0631\u0645\u0630\u064a \u0645\u0646 \u062d\u062f\u064a\u062b \u0623\u0628\u064a \u0647\u0631\u064a\u0631\u0629 \u0628\u0627\u0644\u062a\u0643\u0631\u0627\u0631: \u00ab\u0627\u0644\u062f\u064a\u0646 \u0627\u0644\u0646\u0635\u064a\u062d\u0629\u00bb \u062b\u0644\u0627\u062b \u0645\u0631\u0627\u0631\u060c \u0648\u0630\u0644\u0643 \u0641\u064a\u0647 \u062a\u0639\u0638\u064a\u0645 \u0644\u0634\u0623\u0646 \u0627\u0644\u0646\u0635\u064a\u062d\u0629.",
    "\u0648\u0642\u062f \u0627\u062e\u062a\u0644\u0641 \u0627\u0644\u0639\u0644\u0645\u0627\u0621 \u0641\u064a \u062d\u0635\u0631 \u0627\u0644\u062f\u064a\u0646 \u0641\u064a \u0627\u0644\u0646\u0635\u064a\u062d\u0629 \u0627\u0644\u0630\u064a \u0648\u0631\u062f \u0628\u0627\u0644\u062d\u062f\u064a\u062b: \u0647\u0644 \u0647\u0648 \u062d\u0635\u0631 \u0645\u062c\u0627\u0632\u064a \u0623\u0645 \u062d\u0642\u064a\u0642\u064a\u061f \u0641\u0642\u0627\u0644 \u0628\u0639\u0636\u0647\u0645 \u0643\u0627\u0644\u0645\u0646\u0627\u0648\u064a \u0648\u0627\u0628\u0646 \u0639\u0644\u0627\u0646: \u0625\u0646 \u0645\u0639\u0646\u0627\u0647 \u0623\u0646 \u0627\u0644\u0646\u0635\u064a\u062d\u0629 \u0639\u0645\u0627\u062f \u0627\u0644\u062f\u064a\u0646 \u0648\u0642\u0648\u0627\u0645\u0647\u060c \u0643\u0642\u0648\u0644\u0647 \u0635\u0644\u0649 \u0627\u0644\u0644\u0647 \u0639\u0644\u064a\u0647 \u0648\u0633\u0644\u0645: \u00ab\u0627\u0644\u062d\u062c \u0639\u0631\u0641\u0629\u00bb\u060c \u0641\u0647\u0648 \u0645\u0646 \u0627\u0644\u062d\u0635\u0631 \u0627\u0644\u0645\u062c\u0627\u0632\u064a \u0644\u0627 \u0627\u0644\u062d\u0642\u064a\u0642\u064a. \u0648\u0642\u0627\u0644 \u063a\u064a\u0631\u0647\u0645 \u0643\u0627\u0628\u0646 \u0631\u062c\u0628: \u0625\u0646 \u0647\u0630\u0627 \u064a\u062f\u0644 \u0639\u0644\u0649 \u0623\u0646 \u0627\u0644\u0646\u0635\u064a\u062d\u0629 \u062a\u0634\u0645\u0644 \u062e\u0635\u0627\u0644 \u0627\u0644\u0625\u0633\u0644\u0627\u0645 \u0648\u0627\u0644\u0625\u064a\u0645\u0627\u0646 \u0648\u0627\u0644\u0625\u062d\u0633\u0627\u0646. \u0648\u0642\u0627\u0644 \u0627\u0628\u0646 \u062d\u062c\u0631 \u0627\u0644\u0639\u0633\u0642\u0644\u0627\u0646\u064a: \u064a\u062d\u062a\u0645\u0644 \u0623\u0646 \u064a\u062d\u0645\u0644 \u0627\u0644\u062d\u062f\u064a\u062b \u0639\u0644\u0649 \u0638\u0627\u0647\u0631\u0647\u061b \u0644\u0623\u0646 \u0643\u0644 \u0639\u0645\u0644 \u0644\u0645 \u064a\u0631\u062f \u0628\u0647 \u0639\u0627\u0645\u0644\u0647 \u0627\u0644\u0625\u062e\u0644\u0627\u0635 \u0641\u0644\u064a\u0633 \u0645\u0646 \u0627\u0644\u062f\u064a\u0646.",
    "\u0648\u062a\u0631\u0627\u062c\u0639 \u0627\u0644\u0645\u0633\u0623\u0644\u0629 \u0645\u0639 \u0623\u0647\u0644 \u0627\u0644\u0639\u0644\u0645 \u0644\u0638\u0647\u0648\u0631 \u0627\u0644\u062e\u0644\u0627\u0641 \u0641\u064a\u0647\u0627."
  ],
  "q1": "\u0647\u0644 \u064a\u062c\u0648\u0632 \u0627\u0644\u062c\u0645\u0639 \u0628\u064a\u0646 \u0627\u0644\u0645\u063a\u0631\u0628 \u0648\u0627\u0644\u0639\u0634\u0627\u0621 \u0628\u0633\u0628\u0628 \u0627\u0644\u0645\u0637\u0631 \u0627\u0644\u0634\u062f\u064a\u062f\u061f",
  "a1": [
    "\u0648\u0647\u0630\u0627 \u0627\u0644\u062c\u0645\u0639 \u0645\u0642\u064a\u062f \u0628\u0648\u062c\u0648\u062f \u062d\u0631\u062c \u0638\u0627\u0647\u0631 \u0648\u0645\u0634\u0642\u0629 \u0638\u0627\u0647\u0631\u0629 \u062a\u0639\u064a\u0642 \u0627\u0644\u0646\u0627\u0633 \u0645\u0646 \u0627\u0644\u0648\u0635\u0648\u0644 \u0644\u0644\u0645\u0633\u062c\u062f\u060c \u0623\u0645\u0627 \u0625\u0630\u0627 \u0644\u0645 \u064a\u0648\u062c\u062f \u062d\u0631\u062c \u0638\u0627\u0647\u0631 \u0623\u0648 \u0643\u0627\u0646\u062a \u0627\u0644\u0645\u0634\u0642\u0629 \u064a\u0633\u064a\u0631\u0629 \u0623\u0648 \u0645\u062d\u062a\u0645\u0644\u0629 \u0641\u0644\u0627 \u064a\u062c\u0645\u0639 \u0628\u064a\u0646 \u0627\u0644\u0635\u0644\u0627\u062a\u064a\u0646\u060c \u0648\u0625\u0630\u0627 \u0634\u0643 \u0627\u0644\u0645\u0631\u0621 \u0647\u0644 \u0647\u0646\u0627\u0643 \u062d\u0631\u062c \u0638\u0627\u0647\u0631 \u0623\u0645 \u0644\u0627 \u0641\u0627\u0644\u0623\u0635\u0644 \u0639\u062f\u0645 \u0627\u0644\u062c\u0645\u0639."
  ],
  "q10": "\u0645\u0627 \u0635\u062d\u0629 \u062d\u062f\u064a\u062b: \u0627\u0637\u0644\u0628\u0648\u0627 \u0627\u0644\u0639\u0644\u0645 \u0648\u0644\u0648 \u0641\u064a \u0627\u0644\u0635\u064a\u0646\u061f",
  "a10": [
    "\u0647\u0630\u0627 \u062d\u062f\u064a\u062b \u0645\u0648\u0636\u0648\u0639 \u0644\u0627 \u064a\u0635\u062d \u0639\u0646 \u0627\u0644\u0646\u0628\u064a \u0635\u0644\u0649 \u0627\u0644\u0644\u0647 \u0639\u0644\u064a\u0647 \u0648\u0633\u0644\u0645\u060c \u0648\u0642\u062f \u0630\u0643\u0631\u0647 \u0627\u0628\u0646 \u0627\u0644\u062c\u0648\u0632\u064a \u0641\u064a \u0627\u0644\u0645\u0648\u0636\u0648\u0639\u0627\u062a."
  ],
  "sibR1": [
    "\u0645\u0627 \u0647\u064a \u0623\u0630\u0643\u0627\u0631 \u0645\u0627 \u0628\u0639\u062f \u0627\u0644\u0635\u0644\u0627\u0629 \u0627\u0644\u0645\u0641\u0631\u0648\u0636\u0629\u061f",
    "\u0639\u0644\u0645\u0646\u064a \u0627\u0644\u0623\u0630\u0643\u0627\u0631 \u0627\u0644\u062a\u064a \u062a\u0642\u0627\u0644 \u0628\u0639\u062f \u0627\u0644\u0633\u0644\u0627\u0645 \u0645\u0646 \u0627\u0644\u0641\u0631\u064a\u0636\u0629",
    "\u0645\u0627 \u0627\u0644\u062f\u0639\u0627\u0621 \u0627\u0644\u0630\u064a \u064a\u0642\u0627\u0644 \u0628\u0639\u062f \u0627\u0644\u062a\u0633\u0644\u064a\u0645 \u0645\u0646 \u0635\u0644\u0627\u0629 \u0627\u0644\u0641\u062c\u0631\u061f"
  ],
  "sibR2": [
    "\u062a\u0648\u0641\u064a\u062a \u0627\u0645\u0631\u0623\u0629 \u0648\u062a\u0631\u0643\u062a \u0632\u0648\u062c\u0627 \u0648\u0623\u0628\u0627 \u0648\u0628\u0646\u062a\u0627\u060c \u0641\u0645\u0627 \u0646\u0635\u064a\u0628 \u0643\u0644 \u0648\u0627\u0631\u062b \u0645\u0646 \u0627\u0644\u0645\u064a\u0631\u0627\u062b\u061f",
    "\u062a\u0648\u0641\u064a \u0648\u0627\u0644\u062f\u064a \u0648\u062a\u0631\u0643 \u0623\u0645\u064a \u0648\u062b\u0644\u0627\u062b\u0629 \u0623\u0628\u0646\u0627\u0621 \u0648\u0628\u0646\u062a\u0627\u060c \u0643\u064a\u0641 \u0646\u0642\u0633\u0645 \u0627\u0644\u0645\u064a\u0631\u0627\u062b\u061f",
    "\u0645\u0627\u062a \u0631\u062c\u0644 \u0648\u062a\u0631\u0643 \u0623\u0645\u0627 \u0648\u0623\u062e\u0648\u064a\u0646 \u0648\u0623\u062e\u062a\u0627 \u0634\u0642\u064a\u0642\u0629\u060c \u0641\u0643\u064a\u0641 \u064a\u0642\u0633\u0645 \u0627\u0644\u0645\u064a\u0631\u0627\u062b \u0628\u064a\u0646\u0647\u0645\u061f"
  ],
  "q4Clause": "\u0627\u0639\u062a\u0628\u0631 \u0627\u0644\u0645\u0628\u064a\u062a \u0628\u0645\u0646\u0649 \u0623\u064a\u0627\u0645 \u0627\u0644\u062a\u0634\u0631\u064a\u0642 \u0645\u0646 \u0648\u0627\u062c\u0628\u0627\u062a \u0627\u0644\u062d\u062c \u0641\u064a \u0623\u0635\u062d \u0642\u0648\u0644\u064a \u0623\u0647\u0644 \u0627\u0644\u0639\u0644\u0645.",
  "authHeld11": "\u0639\u0646 \u062a\u0645\u064a\u0645 \u0627\u0644\u062f\u0627\u0631\u064a \u0631\u0636\u064a \u0627\u0644\u0644\u0647 \u0639\u0646\u0647 \u0623\u0646 \u0627\u0644\u0646\u0628\u064a \u0635\u0644\u0649 \u0627\u0644\u0644\u0647 \u0639\u0644\u064a\u0647 \u0648\u0633\u0644\u0645 \u0642\u0627\u0644: \u00ab\u0627\u0644\u062f\u064a\u0646 \u0627\u0644\u0646\u0635\u064a\u062d\u0629\u00bb\u060c \u0642\u0644\u0646\u0627: \u0644\u0645\u0646\u061f",
  "authRowScholars": "\u0627\u0644\u0645\u0628\u064a\u062a \u0628\u0645\u0646\u0649 \u0623\u064a\u0627\u0645 \u0627\u0644\u062a\u0634\u0631\u064a\u0642 \u0645\u0646 \u0648\u0627\u062c\u0628\u0627\u062a \u0627\u0644\u062d\u062c \u0641\u064a \u0623\u0635\u062d \u0642\u0648\u0644\u064a \u0623\u0647\u0644 \u0627\u0644\u0639\u0644\u0645.",
  "authRowNoGroup": "\u0627\u0644\u0645\u0628\u064a\u062a \u0628\u0645\u0646\u0649 \u0623\u064a\u0627\u0645 \u0627\u0644\u062a\u0634\u0631\u064a\u0642 \u0645\u0646 \u0648\u0627\u062c\u0628\u0627\u062a \u0627\u0644\u062d\u062c.",
  "authPronoun": "\u0647\u0630\u0627 \u0627\u0644\u0642\u0648\u0644 \u0645\u0631\u062c\u0648\u062d."
}
