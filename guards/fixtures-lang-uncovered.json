  {
   "text": "يونس",
   "cat": "surah-map-or-normaliser"
  },
  {
   "text": "يَبْدُو أَنَّ الاتِّصَالَ ضَعِيفٌ الآن. تَحَقَّقِي مِنَ الإِنْتَرْنِت وَحَاوِلِي ثَانِيَة.",
   "cat": "other"
  },
  {
   "text": "يَبْدُو أَنَّ الاتِّصَالَ ضَعِيفٌ الآن. تَحَقَّقْ مِنَ الإِنْتَرْنِت وَحَاوِلْ ثَانِيَة.",
   "cat": "other"
  },
  {
   "text": "يَبْدُو أَنَّ الخَادِمَ مَشْغُولٌ الآن. حَاوِلِي مَرَّةً ثَانِيَة بَعْدَ قَلِيل.",
   "cat": "other"
  },
  {
   "text": "يَبْدُو أَنَّ الخَادِمَ مَشْغُولٌ الآن. حَاوِلْ مَرَّةً ثَانِيَة بَعْدَ قَلِيل.",
   "cat": "other"
  },
