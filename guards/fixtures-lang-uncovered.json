  },
  {
   "text": "واحد",
   "cat": "speech-formatter"
  },
  {
   "text": "واخترْ هذه المفاتيحَ بما يناسبُ هذا السؤالَ بعينِه، فالبطاقةُ تُبنى منها.",
   "cat": "model-prompt-or-attribution-vocabulary"
  },
  {
   "text": "وجد",
   "cat": "other"
  },
  {
   "text": "وسمان لـ balance و two-days و clock-window و door-two، ووسمٌ واحدٌ لـ day-mark و page-check",
   "cat": "model-prompt-or-attribution-vocabulary"
  },
  {
   "text": "وليد بن راشد السعيدان",
   "cat": "stored-content-kept-arabic"
  },
  {
   "text": "ووسمان لـ ratio-bar و scale-cup، ولا وسمَ لـ mark-plain.",
   "cat": "model-prompt-or-attribution-vocabulary"
  },
  {
   "text": "وَأَقِيمُوا۟ ٱلصَّلَوٰةَ وَءَاتُوا۟ ٱلزَّكَوٰةَ",
   "cat": "scripture-or-vocalised-data"
  },
  {
   "text": "وَأَن لَّيْسَ لِلْإِنسَـٰنِ إِلَّا مَا سَعَىٰ",
   "cat": "scripture-or-vocalised-data"
  },
  {
   "text": "وَإِذَا سَأَلَكَ عِبَادِى عَنِّى فَإِنِّى قَرِيبٌ",
   "cat": "other"
  },
  {
   "text": "وَبَشِّرِ ٱلصَّـٰبِرِينَ",
   "cat": "scripture-or-vocalised-data"
  },
  {
   "text": "وَتَوَكَّلْ عَلَى ٱللَّهِ ۚ وَكَفَىٰ بِٱللَّهِ وَكِيلًا",
   "cat": "scripture-or-vocalised-data"
  },
  {
   "text": "وَقُل رَّبِّ زِدْنِى عِلْمًا",
   "cat": "other"
  },
  {
   "text": "وَلَا تَتَمَنَّوْا۟ مَا فَضَّلَ ٱللَّهُ بِهِۦ بَعْضَكُمْ عَلَىٰ بَعْضٍ ۚ لِّلرِّجَالِ نَصِيبٌ مِّمَّا ٱكْتَسَبُوا۟ ۖ وَلِلنِّسَآءِ نَصِيبٌ مِّمَّا ٱكْتَسَبْنَ ۚ وَسْـَٔلُوا۟ ٱللَّهَ مِن فَضْلِهِۦٓ ۗ إِنَّ ٱللَّهَ كَانَ بِكُلِّ شَىْءٍ عَلِيمًا",
   "cat": "scripture-or-vocalised-data"
  },
  {
   "text": "وَلَا تَهِنُوا۟ وَلَا تَحْزَنُوا۟ وَأَنتُمُ ٱلْأَعْلَوْنَ",
   "cat": "scripture-or-vocalised-data"
  },
  {
   "text": "وَمَا تَوْفِيقِىٓ إِلَّا بِٱللَّهِ",
   "cat": "scripture-or-vocalised-data"
  },
  {
   "text": "وَمَن يَتَوَكَّلْ عَلَى ٱللَّهِ فَهُوَ حَسْبُهُۥٓ",
   "cat": "scripture-or-vocalised-data"
  },
  {
   "text": "وَمَن يَتَّقِ ٱللَّهَ يَجْعَل لَّهُۥ مَخْرَجًا",
   "cat": "scripture-or-vocalised-data"
  },
  {
   "text": "وَهُوَ مَعَكُمْ أَيْنَ مَا كُنتُمْ",
   "cat": "other"
  },
  {
   "text": "وَٱسْتَعِينُوا۟ بِٱلصَّبْرِ وَٱلصَّلَوٰةِ",
   "cat": "scripture-or-vocalised-data"
  },
  {
   "text": "وَٱلذَّٰكِرِينَ ٱللَّهَ كَثِيرًا وَٱلذَّٰكِرَٰتِ",
   "cat": "scripture-or-vocalised-data"
  },
  {
   "text": "وَٱللَّهُ يُحِبُّ ٱلصَّـٰبِرِينَ",
   "cat": "scripture-or-vocalised-data"
  },
