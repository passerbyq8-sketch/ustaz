        "textKind": "guidance",
        "noteId": "dima.ramadan.20.qalb.note",
        "note": "وَٱلَّذِينَ إِذَا فَعَلُوا۟ فَـٰحِشَةً أَوْ ظَلَمُوٓا۟ أَنفُسَهُمْ ذَكَرُوا۟ ٱللَّهَ فَٱسْتَغْفَرُوا۟ لِذُنُوبِهِمْ وَمَن يَغْفِرُ ٱلذُّنُوبَ إِلَّا ٱللَّهُ وَلَمْ يُصِرُّوا۟ عَلَىٰ مَا فَعَلُوا۟ وَهُمْ يَعْلَمُونَ",
        "kind": "quran",
        "src": "آل عمران: ١٣٥",
        "actionId": "dima.ramadan.20.qalb.action",
        "action": "تأمّلتُ",
        "verified": {
          "surah": 3,
          "ayah": 135
        }
      },
      "jawarih": {
        "id": "dima.ramadan.20.jawarih",
        "text": "اسقِ نبتة تحتاج الماء بقدر حاجتها",
        "textKind": "guidance",
        "noteId": "dima.ramadan.20.jawarih.note",
        "note": "مَا مِنْ مُسْلِمٍ يَغْرِسُ غَرْسًا إِلَّا كَانَ مَا أُكِلَ مِنْهُ لَهُ صَدَقَةً",
        "kind": "hadith",
        "src": "مسلم",
        "actionId": "dima.ramadan.20.jawarih.action",
        "action": "سقيتُها",
        "verified": {
          "book": "صحيح مسلم",
