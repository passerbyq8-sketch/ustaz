    {
      "id": "dima.ramadan.21",
      "position": 21,
      "lisanRef": "l09",
      "qalb": {
        "id": "dima.ramadan.21.qalb",
        "text": "اجعل في يومك لحظة لذكر الله",
        "textKind": "guidance",
        "noteId": "dima.ramadan.21.qalb.note",
        "note": "وَٱذْكُر رَّبَّكَ فِى نَفْسِكَ تَضَرُّعًا وَخِيفَةً وَدُونَ ٱلْجَهْرِ مِنَ ٱلْقَوْلِ بِٱلْغُدُوِّ وَٱلْـَٔاصَالِ وَلَا تَكُن مِّنَ ٱلْغَـٰفِلِينَ",
        "kind": "quran",
        "src": "الأعراف: ٢٠٥",
        "actionId": "dima.ramadan.21.qalb.action",
        "action": "تأمّلتُ",
        "verified": {
          "surah": 7,
          "ayah": 205
