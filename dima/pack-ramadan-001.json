    {
      "id": "dima.ramadan.11",
      "position": 11,
      "lisanRef": "l11",
      "qalb": {
        "id": "dima.ramadan.11.qalb",
        "text": "استحضر شكر الله عند ترتيب طعامك",
        "textKind": "guidance",
        "noteId": "dima.ramadan.11.qalb.note",
        "note": "وَإِذْ تَأَذَّنَ رَبُّكُمْ لَئِن شَكَرْتُمْ لَأَزِيدَنَّكُمْ ۖ وَلَئِن كَفَرْتُمْ إِنَّ عَذَابِى لَشَدِيدٌ",
        "kind": "quran",
        "src": "إبراهيم: ٧",
