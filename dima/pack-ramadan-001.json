      },
      "jawarih": {
        "id": "dima.ramadan.21.jawarih",
        "text": "استعد للصلاة في وقتها بما تحتاجه من غير استعجال",
        "textKind": "guidance",
        "noteId": "dima.ramadan.21.jawarih.note",
        "note": "الصَّلاَةُ عَلَى وَقْتِهَا",
