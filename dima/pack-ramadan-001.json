      "position": 9,
      "lisanRef": "l09",
      "qalb": {
        "id": "dima.ramadan.09.qalb",
        "text": "اسأل الله اليسر فيما يصعب عليك",
        "textKind": "guidance",
        "noteId": "dima.ramadan.09.qalb.note",
        "note": "فَإِنَّ مَعَ ٱلْعُسْرِ يُسْرًا",
        "kind": "quran",
        "src": "الشرح: ٥",
        "actionId": "dima.ramadan.09.qalb.action",
        "action": "تأمّلتُ",
        "verified": {
