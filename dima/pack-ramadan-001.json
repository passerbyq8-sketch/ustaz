    {
      "id": "dima.ramadan.12",
      "position": 12,
      "lisanRef": "l12",
      "qalb": {
        "id": "dima.ramadan.12.qalb",
        "text": "ادع لشخص بعيد عنك",
        "textKind": "guidance",
        "noteId": "dima.ramadan.12.qalb.note",
        "note": "دَعْوَةُ الْمَرْءِ الْمُسْلِمِ لِأَخِيهِ بِظَهْرِ الْغَيْبِ مُسْتَجَابَةٌ، عِنْدَ رَأْسِهِ مَلَكٌ مُوَكَّلٌ كُلَّمَا دَعَا لِأَخِيهِ بِخَيْرٍ، قَالَ الْمَلَكُ الْمُوَكَّلُ بِهِ: آمِينَ وَلَكَ بِمِثْلٍ",
        "kind": "hadith",
        "src": "مسلم",
        "actionId": "dima.ramadan.12.qalb.action",
        "action": "تأمّلتُ",
        "verified": {
          "book": "صحيح مسلم",
          "ref": "4/2094",
          "subjectId": "FC-000648",
          "atomId": "FC-000648:1246:002",
          "volume": 4,
          "page": 2094
        }
      },
      "jawarih": {
        "id": "dima.ramadan.12.jawarih",
        "text": "أبعد شيئًا صغيرًا يؤذي في مكان آمن، أو اطلب مساعدة كبير",
        "textKind": "guidance",
        "noteId": "dima.ramadan.12.jawarih.note",
        "note": "وَأَدْنَاهَا إِمَاطَةُ الْأَذَى عَنِ الطَّرِيقِ",
        "kind": "hadith",
        "src": "مسلم",
        "actionId": "dima.ramadan.12.jawarih.action",
        "action": "أبعدتُ الأذى",
        "verified": {
