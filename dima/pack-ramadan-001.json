          "ayah": 5
        }
      },
      "jawarih": {
        "id": "dima.ramadan.09.jawarih",
        "text": "علّم من يرغب شيئًا نافعًا تعرفه جيدًا",
        "textKind": "guidance",
        "noteId": "dima.ramadan.09.jawarih.note",
        "note": "مَنْ دَلَّ عَلَى خَيْرٍ فَلَهُ مِثْلُ أَجْرِ فَاعِلِهِ",
