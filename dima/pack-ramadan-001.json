    {
      "id": "dima.ramadan.07",
      "position": 7,
      "lisanRef": "l07",
      "qalb": {
        "id": "dima.ramadan.07.qalb",
        "text": "تذكّر من يسّر لك تعلّم شيء نافع",
        "textKind": "guidance",
        "noteId": "dima.ramadan.07.qalb.note",
        "note": "وَٱللَّهُ أَخْرَجَكُم مِّنۢ بُطُونِ أُمَّهَـٰتِكُمْ لَا تَعْلَمُونَ شَيْـًٔا وَجَعَلَ لَكُمُ ٱلسَّمْعَ وَٱلْأَبْصَـٰرَ وَٱلْأَفْـِٔدَةَ ۙ لَعَلَّكُمْ تَشْكُرُونَ",
        "kind": "quran",
        "src": "النحل: ٧٨",
        "actionId": "dima.ramadan.07.qalb.action",
        "action": "تأمّلتُ",
        "verified": {
          "surah": 16,
          "ayah": 78
        }
      },
      "jawarih": {
        "id": "dima.ramadan.07.jawarih",
        "text": "شارك أهلك في تقديم الطعام أو ترتيبه",
        "textKind": "guidance",
        "noteId": "dima.ramadan.07.jawarih.note",
        "note": "تُطْعِمُ الطَّعَامَ، وَتَقْرَأُ السَّلاَمَ عَلَى مَنْ عَرَفْتَ وَمَنْ لَمْ تَعْرِفْ",
        "kind": "hadith",
        "src": "البخاري",
        "actionId": "dima.ramadan.07.jawarih.action",
        "action": "شاركتُ",
        "verified": {
