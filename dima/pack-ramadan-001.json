    {
      "id": "dima.ramadan.25",
      "position": 25,
      "lisanRef": "l01",
      "qalb": {
        "id": "dima.ramadan.25.qalb",
        "text": "اشكر الله على ما تيسّر من العمل",
        "textKind": "guidance",
        "noteId": "dima.ramadan.25.qalb.note",
        "note": "وَإِذْ تَأَذَّنَ رَبُّكُمْ لَئِن شَكَرْتُمْ لَأَزِيدَنَّكُمْ ۖ وَلَئِن كَفَرْتُمْ إِنَّ عَذَابِى لَشَدِيدٌ",
        "kind": "quran",
        "src": "إبراهيم: ٧",
        "actionId": "dima.ramadan.25.qalb.action",
        "action": "تأمّلتُ",
        "verified": {
          "surah": 14,
          "ayah": 7
