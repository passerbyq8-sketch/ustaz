    {
      "id": "dima.ramadan.22",
      "position": 22,
      "lisanRef": "l10",
      "qalb": {
        "id": "dima.ramadan.22.qalb",
        "text": "تأمّل خيرًا تعلمته هذا الشهر",
        "textKind": "guidance",
        "noteId": "dima.ramadan.22.qalb.note",
        "note": "وَٱللَّهُ أَخْرَجَكُم مِّنۢ بُطُونِ أُمَّهَـٰتِكُمْ لَا تَعْلَمُونَ شَيْـًٔا وَجَعَلَ لَكُمُ ٱلسَّمْعَ وَٱلْأَبْصَـٰرَ وَٱلْأَفْـِٔدَةَ ۙ لَعَلَّكُمْ تَشْكُرُونَ",
        "kind": "quran",
        "src": "النحل: ٧٨",
        "actionId": "dima.ramadan.22.qalb.action",
        "action": "تأمّلتُ",
        "verified": {
          "surah": 16,
          "ayah": 78
        }
      },
      "jawarih": {
        "id": "dima.ramadan.22.jawarih",
        "text": "ساعد صغيرًا في تعلّم كلمة أو مهارة نافعة",
        "textKind": "guidance",
        "noteId": "dima.ramadan.22.jawarih.note",
        "note": "مَنْ دَلَّ عَلَى خَيْرٍ فَلَهُ مِثْلُ أَجْرِ فَاعِلِهِ",
        "kind": "hadith",
        "src": "مسلم",
        "actionId": "dima.ramadan.22.jawarih.action",
        "action": "ساعدتُه",
        "verified": {
