    {
      "id": "dima.ramadan.08",
      "position": 8,
      "lisanRef": "l08",
      "qalb": {
        "id": "dima.ramadan.08.qalb",
        "text": "اختر لحظة هادئة لذكر الله",
        "textKind": "guidance",
        "noteId": "dima.ramadan.08.qalb.note",
        "note": "وَٱذْكُر رَّبَّكَ فِى نَفْسِكَ تَضَرُّعًا وَخِيفَةً وَدُونَ ٱلْجَهْرِ مِنَ ٱلْقَوْلِ بِٱلْغُدُوِّ وَٱلْـَٔاصَالِ وَلَا تَكُن مِّنَ ٱلْغَـٰفِلِينَ",
        "kind": "quran",
        "src": "الأعراف: ٢٠٥",
        "actionId": "dima.ramadan.08.qalb.action",
        "action": "تأمّلتُ",
        "verified": {
          "surah": 7,
          "ayah": 205
        }
      },
      "jawarih": {
        "id": "dima.ramadan.08.jawarih",
        "text": "إن غضبت، توقّف قليلًا قبل أن ترد",
        "textKind": "guidance",
        "noteId": "dima.ramadan.08.jawarih.note",
        "note": "لَيْسَ الشَّدِيدُ بِالصُّرَعَةِ، إِنَّمَا الشَّدِيدُ الَّذِي يَمْلِكُ نَفْسَهُ عِنْدَ الغَضَبِ",
        "kind": "hadith",
        "src": "البخاري",
        "actionId": "dima.ramadan.08.jawarih.action",
        "action": "تمهّلتُ",
