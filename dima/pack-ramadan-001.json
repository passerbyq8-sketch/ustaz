      },
      "jawarih": {
        "id": "dima.ramadan.25.jawarih",
        "text": "ابتسم لمن يعمل معك أو يتعلم معك",
        "textKind": "guidance",
        "noteId": "dima.ramadan.25.jawarih.note",
        "note": "تَبَسُّمُكَ فِي وَجْهِ أَخِيكَ لَكَ صَدَقَةٌ",
        "kind": "hadith",
        "src": "الترمذي",
