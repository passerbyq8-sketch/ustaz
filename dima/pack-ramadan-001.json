      "jawarih": {
        "id": "dima.ramadan.11.jawarih",
        "text": "خاطب صغيرًا بكلمة تشجعه ولا تسخر منه",
        "textKind": "guidance",
        "noteId": "dima.ramadan.11.jawarih.note",
        "note": "وَالكَلِمَةُ الطَّيِّبَةُ صَدَقَةٌ",
