  "days": [
    {
      "id": "dima.ramadan.01",
      "position": 1,
      "lisanRef": "l01",
      "qalb": {
        "id": "dima.ramadan.01.qalb",
        "text": "ابدأ يومك في رمضان بنية طيبة في عمل صغير",
        "textKind": "guidance",
        "noteId": "dima.ramadan.01.qalb.note",
        "note": "وَمَآ أُمِرُوٓا۟ إِلَّا لِيَعْبُدُوا۟ ٱللَّهَ مُخْلِصِينَ لَهُ ٱلدِّينَ حُنَفَآءَ وَيُقِيمُوا۟ ٱلصَّلَوٰةَ وَيُؤْتُوا۟ ٱلزَّكَوٰةَ ۚ وَذَٰلِكَ دِينُ ٱلْقَيِّمَةِ",
        "kind": "quran",
        "src": "البينة: ٥",
        "actionId": "dima.ramadan.01.qalb.action",
        "action": "تأمّلتُ",
        "verified": {
          "surah": 98,
          "ayah": 5
        }
      },
      "jawarih": {
        "id": "dima.ramadan.01.jawarih",
        "text": "استقبل أحد أهل بيتك بابتسامة هادئة",
        "textKind": "guidance",
        "noteId": "dima.ramadan.01.jawarih.note",
        "note": "تَبَسُّمُكَ فِي وَجْهِ أَخِيكَ لَكَ صَدَقَةٌ",
        "kind": "hadith",
        "src": "الترمذي",
        "actionId": "dima.ramadan.01.jawarih.action",
        "action": "ابتسمتُ",
        "verified": {
          "book": "سنن الترمذي ت بشار",
          "ref": "3/404",
          "subjectId": "FC-000658",
          "atomId": "FC-000658:1351:001",
          "volume": 3,
          "page": 404
        }
      },
      "teaser": {
        "id": "dima.ramadan.01.teaser",
        "text": "خير يسير في رمضان"
      },
      "notification": {
        "id": "dima.ramadan.01.notification",
        "text": "ديمة اليوم جاهزة، خذ منها ما تستطيع"
      }
    },
    {
      "id": "dima.ramadan.02",
      "position": 2,
      "lisanRef": "l02",
      "qalb": {
        "id": "dima.ramadan.02.qalb",
        "text": "تأمّل نعمة اجتماع أهلك على الخير",
        "textKind": "guidance",
        "noteId": "dima.ramadan.02.qalb.note",
        "note": "وَإِذْ تَأَذَّنَ رَبُّكُمْ لَئِن شَكَرْتُمْ لَأَزِيدَنَّكُمْ ۖ وَلَئِن كَفَرْتُمْ إِنَّ عَذَابِى لَشَدِيدٌ",
        "kind": "quran",
        "src": "إبراهيم: ٧",
        "actionId": "dima.ramadan.02.qalb.action",
        "action": "تأمّلتُ",
        "verified": {
          "surah": 14,
          "ayah": 7
        }
      },
      "jawarih": {
        "id": "dima.ramadan.02.jawarih",
        "text": "رتّب شيئًا مشتركًا في البيت لتخفّف عن أهلك",
        "textKind": "guidance",
        "noteId": "dima.ramadan.02.jawarih.note",
        "note": "كَانَ يَكُونُ فِي مِهْنَةِ أَهْلِهِ",
        "kind": "hadith",
        "src": "البخاري",
        "actionId": "dima.ramadan.02.jawarih.action",
        "action": "ساعدتُ",
        "verified": {
          "book": "صحيح البخاري",
          "ref": "1/136",
          "subjectId": "FC-000645",
          "atomId": "FC-000645:0434:001",
          "volume": 1,
          "page": 136
        }
      },
      "teaser": {
        "id": "dima.ramadan.02.teaser",
        "text": "خير يسير في رمضان"
      },
      "notification": {
        "id": "dima.ramadan.02.notification",
        "text": "ديمة اليوم جاهزة، خذ منها ما تستطيع"
      }
    },
    {
      "id": "dima.ramadan.03",
      "position": 3,
      "lisanRef": "l03",
      "qalb": {
        "id": "dima.ramadan.03.qalb",
        "text": "ادع لمن تذكّرت من أهلك وأصحابك",
        "textKind": "guidance",
        "noteId": "dima.ramadan.03.qalb.note",
        "note": "دَعْوَةُ الْمَرْءِ الْمُسْلِمِ لِأَخِيهِ بِظَهْرِ الْغَيْبِ مُسْتَجَابَةٌ، عِنْدَ رَأْسِهِ مَلَكٌ مُوَكَّلٌ كُلَّمَا دَعَا لِأَخِيهِ بِخَيْرٍ، قَالَ الْمَلَكُ الْمُوَكَّلُ بِهِ: آمِينَ وَلَكَ بِمِثْلٍ",
        "kind": "hadith",
        "src": "مسلم",
        "actionId": "dima.ramadan.03.qalb.action",
        "action": "تأمّلتُ",
        "verified": {
          "book": "صحيح مسلم",
          "ref": "4/2094",
          "subjectId": "FC-000648",
          "atomId": "FC-000648:1246:002",
          "volume": 4,
          "page": 2094
        }
      },
      "jawarih": {
        "id": "dima.ramadan.03.jawarih",
        "text": "قل كلمة طيبة لشخص بذل جهدًا اليوم",
        "textKind": "guidance",
        "noteId": "dima.ramadan.03.jawarih.note",
        "note": "وَالكَلِمَةُ الطَّيِّبَةُ صَدَقَةٌ",
        "kind": "hadith",
        "src": "البخاري",
        "actionId": "dima.ramadan.03.jawarih.action",
        "action": "قلتُ خيرًا",
        "verified": {
          "book": "صحيح البخاري",
          "ref": "4/56",
          "subjectId": "FC-000645",
          "atomId": "FC-000645:1856:001",
          "volume": 4,
          "page": 56
        }
      },
      "teaser": {
        "id": "dima.ramadan.03.teaser",
        "text": "خير يسير في رمضان"
      },
      "notification": {
        "id": "dima.ramadan.03.notification",
        "text": "ديمة اليوم جاهزة، خذ منها ما تستطيع"
      }
    },
    {
      "id": "dima.ramadan.04",
      "position": 4,
      "lisanRef": "l04",
      "qalb": {
        "id": "dima.ramadan.04.qalb",
        "text": "تأنّ في كلامك عندما تنشغل",
        "textKind": "guidance",
        "noteId": "dima.ramadan.04.qalb.note",
        "note": "مَنْ كَانَ يُؤْمِنُ بِاللَّهِ وَاليَوْمِ الآخِرِ فَلْيَقُلْ خَيْرًا أَوْ لِيَصْمُتْ",
        "kind": "hadith",
        "src": "البخاري",
        "actionId": "dima.ramadan.04.qalb.action",
        "action": "تأمّلتُ",
        "verified": {
          "book": "صحيح البخاري",
          "ref": "8/11",
          "subjectId": "FC-000645",
          "atomId": "FC-000645:3194:001",
          "volume": 8,
          "page": 11
        }
      },
      "jawarih": {
        "id": "dima.ramadan.04.jawarih",
        "text": "قدّم مساعدة صغيرة من غير أن تتحدث عنها",
        "textKind": "guidance",
        "noteId": "dima.ramadan.04.jawarih.note",
        "note": "وَرَجُلٌ تَصَدَّقَ بِصَدَقَةٍ فَأَخْفَاهَا حَتَّى لاَ تَعْلَمَ شِمَالُهُ مَا تُنْفِقُ يَمِينُهُ",
        "kind": "hadith",
        "src": "البخاري",
        "actionId": "dima.ramadan.04.jawarih.action",
        "action": "ساعدتُ",
        "verified": {
          "book": "صحيح البخاري",
          "ref": "2/111",
          "subjectId": "FC-000645",
          "atomId": "FC-000645:0891:001",
          "volume": 2,
          "page": 111
        }
      },
      "teaser": {
        "id": "dima.ramadan.04.teaser",
        "text": "خير يسير في رمضان"
      },
      "notification": {
        "id": "dima.ramadan.04.notification",
        "text": "ديمة اليوم جاهزة، خذ منها ما تستطيع"
      }
    },
    {
      "id": "dima.ramadan.05",
      "position": 5,
      "lisanRef": "l05",
      "qalb": {
        "id": "dima.ramadan.05.qalb",
        "text": "اشكر الله على ما تجد من طعام وماء",
        "textKind": "guidance",
        "noteId": "dima.ramadan.05.qalb.note",
        "note": "وَإِن تَعُدُّوا۟ نِعْمَةَ ٱللَّهِ لَا تُحْصُوهَآ ۗ إِنَّ ٱللَّهَ لَغَفُورٌ رَّحِيمٌ",
        "kind": "quran",
        "src": "النحل: ١٨",
        "actionId": "dima.ramadan.05.qalb.action",
        "action": "تأمّلتُ",
        "verified": {
          "surah": 16,
          "ayah": 18
        }
      },
      "jawarih": {
        "id": "dima.ramadan.05.jawarih",
        "text": "اسأل قريبًا عن حاله بكلمة أو رسالة لطيفة",
        "textKind": "guidance",
        "noteId": "dima.ramadan.05.jawarih.note",
        "note": "مَنْ أَحَبَّ أَنْ يُبْسَطَ لَهُ فِي رِزْقِهِ، وَيُنْسَأَ لَهُ فِي أَثَرِهِ، فَلْيَصِلْ رَحِمَهُ",
        "kind": "hadith",
        "src": "البخاري",
        "actionId": "dima.ramadan.05.jawarih.action",
        "action": "وصلتُ رحمي",
        "verified": {
          "book": "صحيح البخاري",
          "ref": "8/5",
          "subjectId": "FC-000645",
          "atomId": "FC-000645:3175:001",
          "volume": 8,
          "page": 5
        }
      },
      "teaser": {
        "id": "dima.ramadan.05.teaser",
