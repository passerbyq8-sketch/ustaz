      },
      "jawarih": {
        "id": "dima.ramadan.27.jawarih",
        "text": "أصلح أثر كلمة آذيت بها أحدًا باعتذار لطيف",
        "textKind": "guidance",
        "noteId": "dima.ramadan.27.jawarih.note",
        "note": "وَأَتْبِعِ السَّيِّئَةَ الْحَسَنَةَ تَمْحُهَا",
