      "jawarih": {
        "id": "dima.ramadan.26.jawarih",
        "text": "اقرأ مما تحفظ من القرآن بتأنّ",
        "textKind": "guidance",
        "noteId": "dima.ramadan.26.jawarih.note",
        "note": "مَنْ قَرَأَ حَرْفًا مِنْ كِتَابِ اللهِ فَلَهُ بِهِ حَسَنَةٌ، وَالحَسَنَةُ بِعَشْرِ أَمْثَالِهَا",
        "kind": "hadith",
        "src": "الترمذي",
        "actionId": "dima.ramadan.26.jawarih.action",
        "action": "قرأتُ",
        "verified": {
          "book": "سنن الترمذي ت بشار",
