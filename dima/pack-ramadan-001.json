    {
      "id": "dima.ramadan.27",
      "position": 27,
      "lisanRef": "l03",
      "qalb": {
        "id": "dima.ramadan.27.qalb",
        "text": "راجع كلمة تريد أن تقولها، واختر خيرها",
        "textKind": "guidance",
        "noteId": "dima.ramadan.27.qalb.note",
        "note": "مَنْ كَانَ يُؤْمِنُ بِاللَّهِ وَاليَوْمِ الآخِرِ فَلْيَقُلْ خَيْرًا أَوْ لِيَصْمُتْ",
