    {
      "id": "dima.ramadan.24",
      "position": 24,
      "lisanRef": "l12",
      "qalb": {
        "id": "dima.ramadan.24.qalb",
        "text": "ادع بالخير لمن تعرف ومن لا تعرف",
        "textKind": "guidance",
        "noteId": "dima.ramadan.24.qalb.note",
        "note": "دَعْوَةُ الْمَرْءِ الْمُسْلِمِ لِأَخِيهِ بِظَهْرِ الْغَيْبِ مُسْتَجَابَةٌ، عِنْدَ رَأْسِهِ مَلَكٌ مُوَكَّلٌ كُلَّمَا دَعَا لِأَخِيهِ بِخَيْرٍ، قَالَ الْمَلَكُ الْمُوَكَّلُ بِهِ: آمِينَ وَلَكَ بِمِثْلٍ",
        "kind": "hadith",
        "src": "مسلم",
        "actionId": "dima.ramadan.24.qalb.action",
        "action": "تأمّلتُ",
        "verified": {
          "book": "صحيح مسلم",
          "ref": "4/2094",
          "subjectId": "FC-000648",
          "atomId": "FC-000648:1246:002",
          "volume": 4,
          "page": 2094
        }
      },
      "jawarih": {
        "id": "dima.ramadan.24.jawarih",
        "text": "ساعد شخصًا في حمل شيء خفيف مناسب لقدرتك",
        "textKind": "guidance",
        "noteId": "dima.ramadan.24.jawarih.note",
        "note": "وَاللهُ فِي عَوْنِ الْعَبْدِ مَا كَانَ الْعَبْدُ فِي عَوْنِ أَخِيهِ",
        "kind": "hadith",
        "src": "مسلم",
        "actionId": "dima.ramadan.24.jawarih.action",
        "action": "ساعدتُ",
        "verified": {
          "book": "صحيح مسلم",
          "ref": "4/2074",
