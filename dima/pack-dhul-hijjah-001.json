  "days": [
    {
      "id": "dima.dhul-hijjah.01",
      "position": 1,
      "lisanRef": "l01",
      "qalb": {
        "id": "dima.dhul-hijjah.01.qalb",
        "text": "ابدأ هذه الأيام بنية طيبة في عمل تستطيع فعله",
        "textKind": "guidance",
        "noteId": "dima.dhul-hijjah.01.qalb.note",
        "note": "وَمَآ أُمِرُوٓا۟ إِلَّا لِيَعْبُدُوا۟ ٱللَّهَ مُخْلِصِينَ لَهُ ٱلدِّينَ حُنَفَآءَ وَيُقِيمُوا۟ ٱلصَّلَوٰةَ وَيُؤْتُوا۟ ٱلزَّكَوٰةَ ۚ وَذَٰلِكَ دِينُ ٱلْقَيِّمَةِ",
        "kind": "quran",
        "src": "البينة: ٥",
        "actionId": "dima.dhul-hijjah.01.qalb.action",
        "action": "جدّدتُ نيتي",
        "verified": {
          "surah": 98,
          "ayah": 5
        }
      },
      "jawarih": {
        "id": "dima.dhul-hijjah.01.jawarih",
        "text": "ساعد أهلك في عمل صغير اليوم",
        "textKind": "guidance",
        "noteId": "dima.dhul-hijjah.01.jawarih.note",
        "note": "كَانَ يَكُونُ فِي مِهْنَةِ أَهْلِهِ",
        "kind": "hadith",
        "src": "البخاري",
        "actionId": "dima.dhul-hijjah.01.jawarih.action",
        "action": "ساعدتُ",
        "verified": {
          "book": "صحيح البخاري",
          "ref": "1/136",
          "subjectId": "FC-000645",
          "atomId": "FC-000645:0434:001",
          "volume": 1,
          "page": 136
        }
      },
      "teaser": {
        "id": "dima.dhul-hijjah.01.teaser",
        "text": "خير يسير في هذه الأيام"
      },
      "notification": {
        "id": "dima.dhul-hijjah.01.notification",
        "text": "ديمة اليوم جاهزة، خذ منها ما تستطيع"
      }
    },
    {
      "id": "dima.dhul-hijjah.02",
      "position": 2,
      "lisanRef": "l02",
      "qalb": {
        "id": "dima.dhul-hijjah.02.qalb",
        "text": "اجعل لك لحظة هادئة لذكر الله",
        "textKind": "guidance",
        "noteId": "dima.dhul-hijjah.02.qalb.note",
        "note": "وَٱذْكُر رَّبَّكَ فِى نَفْسِكَ تَضَرُّعًا وَخِيفَةً وَدُونَ ٱلْجَهْرِ مِنَ ٱلْقَوْلِ بِٱلْغُدُوِّ وَٱلْـَٔاصَالِ وَلَا تَكُن مِّنَ ٱلْغَـٰفِلِينَ",
        "kind": "quran",
        "src": "الأعراف: ٢٠٥",
        "actionId": "dima.dhul-hijjah.02.qalb.action",
        "action": "ذكرتُ الله",
        "verified": {
          "surah": 7,
          "ayah": 205
        }
      },
      "jawarih": {
        "id": "dima.dhul-hijjah.02.jawarih",
        "text": "قل كلمة طيبة لمن حولك",
        "textKind": "guidance",
        "noteId": "dima.dhul-hijjah.02.jawarih.note",
        "note": "وَالكَلِمَةُ الطَّيِّبَةُ صَدَقَةٌ",
        "kind": "hadith",
        "src": "البخاري",
        "actionId": "dima.dhul-hijjah.02.jawarih.action",
        "action": "قلتُ خيرًا",
        "verified": {
          "book": "صحيح البخاري",
          "ref": "4/56",
          "subjectId": "FC-000645",
          "atomId": "FC-000645:1856:001",
          "volume": 4,
          "page": 56
        }
      },
      "teaser": {
        "id": "dima.dhul-hijjah.02.teaser",
        "text": "خير يسير في هذه الأيام"
      },
      "notification": {
        "id": "dima.dhul-hijjah.02.notification",
