    {
      "id": "dima.dhul-hijjah.06",
      "position": 6,
      "lisanRef": "l06",
      "qalb": {
        "id": "dima.dhul-hijjah.06.qalb",
        "text": "تأمّل كيف تصبر في موقف صغير اليوم",
        "textKind": "guidance",
        "noteId": "dima.dhul-hijjah.06.qalb.note",
        "note": "قُلْ يَـٰعِبَادِ ٱلَّذِينَ ءَامَنُوا۟ ٱتَّقُوا۟ رَبَّكُمْ ۚ لِلَّذِينَ أَحْسَنُوا۟ فِى هَـٰذِهِ ٱلدُّنْيَا حَسَنَةٌ ۗ وَأَرْضُ ٱللَّهِ وَٰسِعَةٌ ۗ إِنَّمَا يُوَفَّى ٱلصَّـٰبِرُونَ أَجْرَهُم بِغَيْرِ حِسَابٍ",
        "kind": "quran",
        "src": "الزمر: ١٠",
        "actionId": "dima.dhul-hijjah.06.qalb.action",
        "action": "تأمّلتُ",
        "verified": {
          "surah": 39,
          "ayah": 10
        }
      },
      "jawarih": {
        "id": "dima.dhul-hijjah.06.jawarih",
        "text": "إذا غضبت فتمهّل قبل الرد",
        "textKind": "guidance",
        "noteId": "dima.dhul-hijjah.06.jawarih.note",
        "note": "لَيْسَ الشَّدِيدُ بِالصُّرَعَةِ، إِنَّمَا الشَّدِيدُ الَّذِي يَمْلِكُ نَفْسَهُ عِنْدَ الغَضَبِ",
        "kind": "hadith",
        "src": "البخاري",
        "actionId": "dima.dhul-hijjah.06.jawarih.action",
