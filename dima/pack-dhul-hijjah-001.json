    {
      "id": "dima.dhul-hijjah.04",
      "position": 4,
      "lisanRef": "l04",
      "qalb": {
        "id": "dima.dhul-hijjah.04.qalb",
        "text": "ادع لأهلك ولمن تحب له الخير",
        "textKind": "guidance",
        "noteId": "dima.dhul-hijjah.04.qalb.note",
        "note": "دَعْوَةُ الْمَرْءِ الْمُسْلِمِ لِأَخِيهِ بِظَهْرِ الْغَيْبِ مُسْتَجَابَةٌ، عِنْدَ رَأْسِهِ مَلَكٌ مُوَكَّلٌ كُلَّمَا دَعَا لِأَخِيهِ بِخَيْرٍ، قَالَ الْمَلَكُ الْمُوَكَّلُ بِهِ: آمِينَ وَلَكَ بِمِثْلٍ",
        "kind": "hadith",
        "src": "مسلم",
        "actionId": "dima.dhul-hijjah.04.qalb.action",
        "action": "دعوتُ",
        "verified": {
          "book": "صحيح مسلم",
          "ref": "4/2094",
          "subjectId": "FC-000648",
          "atomId": "FC-000648:1246:002",
          "volume": 4,
          "page": 2094
        }
      },
      "jawarih": {
        "id": "dima.dhul-hijjah.04.jawarih",
        "text": "اسأل قريبًا عن حاله بلطف",
        "textKind": "guidance",
        "noteId": "dima.dhul-hijjah.04.jawarih.note",
        "note": "مَنْ أَحَبَّ أَنْ يُبْسَطَ لَهُ فِي رِزْقِهِ، وَيُنْسَأَ لَهُ فِي أَثَرِهِ، فَلْيَصِلْ رَحِمَهُ",
        "kind": "hadith",
        "src": "البخاري",
        "actionId": "dima.dhul-hijjah.04.jawarih.action",
        "action": "وصلتُ رحمي",
        "verified": {
          "book": "صحيح البخاري",
