      }
    },
    {
      "id": "dima.dhul-hijjah.03",
      "position": 3,
      "lisanRef": "l03",
      "qalb": {
        "id": "dima.dhul-hijjah.03.qalb",
        "text": "تذكّر نعمة من نعم الله عليك واشكره",
        "textKind": "guidance",
        "noteId": "dima.dhul-hijjah.03.qalb.note",
        "note": "وَإِن تَعُدُّوا۟ نِعْمَةَ ٱللَّهِ لَا تُحْصُوهَآ ۗ إِنَّ ٱللَّهَ لَغَفُورٌ رَّحِيمٌ",
        "kind": "quran",
        "src": "النحل: ١٨",
        "actionId": "dima.dhul-hijjah.03.qalb.action",
        "action": "شكرتُ الله",
        "verified": {
          "surah": 16,
          "ayah": 18
        }
      },
      "jawarih": {
        "id": "dima.dhul-hijjah.03.jawarih",
        "text": "شارك بشيء يسير تملكه إن استطعت",
        "textKind": "guidance",
        "noteId": "dima.dhul-hijjah.03.jawarih.note",
        "note": "اتَّقُوا النَّارَ وَلَوْ بِشِقِّ تَمْرَةٍ",
        "kind": "hadith",
        "src": "البخاري",
        "actionId": "dima.dhul-hijjah.03.jawarih.action",
        "action": "شاركتُ",
        "verified": {
          "book": "صحيح البخاري",
          "ref": "2/109",
          "subjectId": "FC-000645",
          "atomId": "FC-000645:0885:001",
          "volume": 2,
          "page": 109
        }
      },
      "teaser": {
        "id": "dima.dhul-hijjah.03.teaser",
        "text": "خير يسير في هذه الأيام"
