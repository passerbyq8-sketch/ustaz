      "jawarih": {
        "id": "dima.dhul-hijjah.07.jawarih",
        "text": "علّم من يرغب شيئًا نافعًا تعرفه",
        "textKind": "guidance",
        "noteId": "dima.dhul-hijjah.07.jawarih.note",
        "note": "مَنْ دَلَّ عَلَى خَيْرٍ فَلَهُ مِثْلُ أَجْرِ فَاعِلِهِ",
