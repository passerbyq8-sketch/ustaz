      "jawarih": {
        "id": "dima.regular.034.jawarih",
        "text": "قدّم مساعدة صغيرة من غير أن تتحدث عنها",
        "textKind": "guidance",
        "noteId": "dima.regular.034.jawarih.note",
        "note": "وَرَجُلٌ تَصَدَّقَ بِصَدَقَةٍ فَأَخْفَاهَا حَتَّى لاَ تَعْلَمَ شِمَالُهُ مَا تُنْفِقُ يَمِينُهُ",
        "kind": "hadith",
        "src": "البخاري",
        "actionId": "dima.regular.034.jawarih.action",
        "action": "ساعدتُ",
        "verified": {
