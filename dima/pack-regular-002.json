      "qalb": {
        "id": "dima.regular.031.qalb",
        "text": "تذكّر نعمة صغيرة في يومك، واحمد الله عليها",
        "textKind": "guidance",
        "noteId": "dima.regular.031.qalb.note",
        "note": "وَإِن تَعُدُّوا۟ نِعْمَةَ ٱللَّهِ لَا تُحْصُوهَآ ۗ إِنَّ ٱللَّهَ لَغَفُورٌ رَّحِيمٌ",
