    "quest.ui.s_a6c3b3a9feed": "ማን በትክክል መለሰ?",
    "quest.ui.s_e47a00ae5a0f": "ነጥቦቹን ስጥ",
    "quest.ui.s_1cd9131a0d83": "ማንም አልመለሰም",
    "quest.ui.s_7bfc89b0ae00": "ማንም ነጥብ አላገኘም",
    "quest.ui.s_6a133e064f71": "መግባታችሁን መመለስ አልተቻለም፤ እንደገና ተቀላቀሉ።",
    "quest.ui.s_916003258b62": "በዚህ ቁጥር ክፍል አልተገኘም።",
    "quest.ui.s_1d44ab4db380": "ክፍሉ ተዘግቷል።",
