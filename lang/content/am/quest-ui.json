    "quest.ui.s_1fb61a96b9fd": "ለዚህ ምድብ አሁን የሚገኙ ጥያቄዎች የሉም፤ ወደ ዝግጅት ተመልሳችሁ ሌላ ምድብ ምረጡ።",
    "quest.ui.s_2370ce18f493": "አሸናፊው «",
    "quest.ui.s_b505794e0a9b": "ሀብታችሁን ይዛችሁ ወጥታችኋል",
    "quest.ui.s_4263501b47f8": "በጉዞው ሀብት አቻ ሆናችኋል",
    "quest.ui.s_1816786267e7": "ከፍተኛውን ሀብት ያገኘው ቡድን «",
    "quest.ui.s_2eb22d1063c7": "ደሴቱ እንቅስቃሴ አቁማለች፤ ሌላ ምረጡ።",
    "quest.ui.s_36b968f28329": "ጠባቂው ብቻ ካለበት ደሴት ጥቃት ማድረግ አይቻልም።",
    "quest.ui.s_49d766fac345": "የዚህ ተራ መነሻ አይቀየርም።",
    "quest.ui.s_2e47cc7343ff": "ደሴቱ እንቅስቃሴ አቁማለች፤ ሌላ ምረጡ።",
    "quest.ui.s_e0ba9959ba6d": "በመንገድ የተገናኘች ደሴት ምረጡ።",
    "quest.ui.s_c27313809d7e": "ባለቤትነቱ ተዛውሯል፤ ባንዲራዎቹን ወደ አዲሷ ደሴት ማንቀሳቀስ ትችላላችሁ።",
    "quest.ui.s_35fa5dff246f": "በጦርነቱ የማሸነፍ መስፈርት ተሟልቷል።",
    "quest.ui.s_e53cbd79f789": "የደሴቶች ጀብዱ አብቅቷል፤ አሸናፊው በደሴቶች ብዛት፣ ከዚያም በባንዲራዎች ብዛት ይወሰናል።",
    "quest.ui.s_dc32764c6456": "አሸናፊው በደሴቶች ብዛት፣ ከዚያም በባንዲራዎች ብዛት ይወሰናል።",
    "quest.ui.s_1c433fc7fae7": "ወደ ክፍሉ መመለስ አልተቻለም።",
    "quest.ui.s_1df0cf4a7743": "ክፍሎቹ የአሁኑን አገልጋያቸውን የጥያቄ ቋት ይጠቀማሉ። ለክፍሉ የቋቱን ምድቦች ምረጡ፣ ወይም በእነዚህ ምድቦች በአንድ መሣሪያ ተጫወቱ።",
    "quest.ui.s_b39a298bd235": "የክፍሉ ኮድ ከአራት እስከ ስድስት አሃዞች ይሆናል።",
    "quest.ui.s_fe2cb24623b0": "ይህ ጊዜ ወይም የአማራጭ ማሳያ እድል የአሁኑ የክፍሎች አገልጋይ ከሚቀበለው ውጭ ነው፤ ሌላ ቅንብር ምረጡ ወይም በአንድ መሣሪያ ተጫወቱ።",
