    {
      "id": "h:8bd511691f0f",
      "kind": "quran",
      "ar": "وَمَن يَتَّقِ ٱللَّهَ يَجْعَل لَّهُۥ مَخْرَجًا",
      "tr": "Yeroo beellama isaanii ga'an haala gaariin isaan qabadhaa yookiin haala gaariin isaaniin adda ba'aa, Isin irraa warra haqaa (nama) lama ragaa godhaa (Warri ragaa baatanus) Rabbiif jedhaatii ragaa sirreessaa. Namni Rabbiifi Guyyaa Aakhiraatti kan amanu ta'e kanaan gorfama. Namni Rabbiin sodaatu (Rabbis) karaa bahiinsaa isaaf godha.",
      "translit": "",
      "tag": "published",
      "src": {
        "name": "Oromo Translation - Gali Ababor",
        "url": "https://quranenc.com/en/browse/oromo_ababor",
        "rights": "Attributed reuse, see SOURCES",
        "date": "",
        "ref": "65:2"
      }
