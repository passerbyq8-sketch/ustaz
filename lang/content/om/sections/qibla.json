    },
    {
      "id": "h:7977f792634c",
      "kind": "text",
      "ar": "استخدمْ موقعَ هذا الجهاز",
      "tr": "Bakka meeshaan kun jiru fayyadami",
      "translit": "",
      "tag": "machine",
      "src": {
