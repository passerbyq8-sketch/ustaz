        }
      ]
    },
    {
      "id": "h:63956bee305f",
      "kind": "text",
      "ar": "عُدْ إلى الموضع الافتراضيّ",
      "tr": "Gara bakka dursee filatameetti deebi'i",
      "translit": "",
      "tag": "machine",
      "src": {
        "name": "machine",
        "url": "",
        "rights": "",
        "date": ""
      },
      "source_paths": [
        {
