          "pointer": "/line:33883"
        }
      ]
    },
    {
      "id": "h:5f6c9424b33c",
      "kind": "text",
      "ar": "يُطلَبُ الإذنُ بالموقع الآن…",
      "tr": "Amma hayyamni bakka beekuu gaafatamaa jira…",
      "translit": "",
      "tag": "machine",
      "src": {
        "name": "machine",
        "url": "",
        "rights": "",
        "date": ""
      },
      "source_paths": [
        {
          "file": "app.jsx",
          "pointer": "/line:33884"
        }
      ]
    },
    {
      "id": "h:9b75ad06a4af",
      "kind": "text",
      "ar": "لم يُمنَحِ الإذنُ بالموقع، والموضعُ الافتراضيُّ باقٍ كما هو.",
      "tr": "Hayyamni bakka beekuu hin kennamne; bakki dursee filatame akkuma jirutti hafa.",
      "translit": "",
      "tag": "machine",
      "src": {
        "name": "machine",
        "url": "",
        "rights": "",
        "date": ""
      },
      "source_paths": [
        {
          "file": "app.jsx",
          "pointer": "/line:33885"
        }
      ]
    },
    {
      "id": "h:70bd2cf35734",
      "kind": "text",
      "ar": "شغِّلِ البوصلة",
      "tr": "Kompaasii hojii jalqabsiisi",
      "translit": "",
      "tag": "machine",
      "src": {
        "name": "machine",
        "url": "",
        "rights": "",
        "date": ""
      },
      "source_paths": [
        {
          "file": "app.jsx",
          "pointer": "/line:33886"
        }
      ]
    },
    {
      "id": "h:1e608e6c09e8",
      "kind": "text",
      "ar": "بانتظارِ قراءةٍ من حسّاسِ الاتّجاه…",
      "tr": "Dubbisa sensara kallattii irraa eegaa jira…",
      "translit": "",
      "tag": "machine",
      "src": {
        "name": "machine",
        "url": "",
        "rights": "",
        "date": ""
      },
      "source_paths": [
        {
          "file": "app.jsx",
          "pointer": "/line:33887"
        }
      ]
    },
    {
      "id": "h:e7f7fb0e4520",
      "kind": "text",
      "ar": "لا تدورُ البوصلةُ على هذا الجهاز: لم تصلْ قراءةٌ صالحةٌ من حسّاسِ الاتّجاه، فالدرجةُ وحدَها هي المعروضة.",
      "tr": "Kompaasiin meeshaa kana irratti hin naanna'u: dubbisni sirrii sensara kallattii irraa hin dhufne; digrii qofatu mul'ata.",
      "translit": "",
      "tag": "machine",
      "src": {
        "name": "machine",
        "url": "",
        "rights": "",
        "date": ""
      },
      "source_paths": [
        {
          "file": "app.jsx",
          "pointer": "/line:33888"
        }
      ]
    },
    {
      "id": "h:992f08c7433f",
      "kind": "text",
      "ar": "البوصلةُ تدورُ مع الجهاز.",
      "tr": "Kompaasiin meeshaa wajjin naanna'a.",
      "translit": "",
      "tag": "machine",
      "src": {
        "name": "machine",
        "url": "",
        "rights": "",
        "date": ""
      },
      "source_paths": [
        {
          "file": "app.jsx",
          "pointer": "/line:33889"
        }
      ]
    },
    {
      "id": "h:704fed17b18c",
      "kind": "text",
      "ar": "السهمُ يدورُ، لكنَّ معايرةَ حسّاسِ الاتّجاهِ ناقصة. حرِّكِ الجهازَ ببطءٍ على شكلِ الرقم ٨ حتّى تتحسّنَ المعايرة.",
      "tr": "Xiyyi ni naanna'a; garuu sirreeffamni sensara kallattii guutuu miti. Hanga sirreeffamni fooyya'utti meeshaa suuta bifa lakkoofsa 8tiin sochoosi.",
      "translit": "",
      "tag": "machine",
      "src": {
        "name": "machine",
        "url": "",
        "rights": "",
        "date": ""
      },
      "source_paths": [
        {
          "file": "app.jsx",
          "pointer": "/line:33890"
        }
      ]
    },
    {
      "id": "h:b59e97600022",
      "kind": "text",
      "ar": "لا يحتوي هذا الجهازُ على حسّاسِ اتّجاهٍ متاح؛ تبقى درجةُ القبلةِ المعروضةُ أعلاه.",
      "tr": "Meeshaan kun sensara kallattii fayyadamuun danda'amu hin qabu; digriin Qiblaa armaan olitti mul'atu ni hafa.",
      "translit": "",
      "tag": "machine",
      "src": {
        "name": "machine",
        "url": "",
        "rights": "",
        "date": ""
      },
      "source_paths": [
        {
          "file": "app.jsx",
          "pointer": "/line:33891"
        }
      ]
    },
    {
      "id": "h:e06d7d45ae56",
      "kind": "text",
      "ar": "إذنُ الموقعِ مرفوض. افتحْ إعداداتِ الجهازِ الخاصّةَ بتطبيقِ عزك وامنحْ إذنَ الموقع، ثم عُدْ إلى هذه الشاشة.",
      "tr": "Hayyamni bakka beekuu didameera. Qindaa'ina meeshaa kee keessaa kan appii Ezik baniitii hayyama bakka beekuu kenni; achiis gara fuula kanaatti deebi'i.",
      "translit": "",
      "tag": "machine",
      "src": {
        "name": "machine",
        "url": "",
        "rights": "",
        "date": ""
      },
      "source_paths": [
        {
          "file": "app.jsx",
          "pointer": "/line:33892"
        }
      ]
    },
    {
      "id": "h:e7ad79ae81a9",
      "kind": "text",
      "ar": "تعذّرتْ قراءةُ اتّجاهِ الجهازِ بسببِ عطبٍ طارئ. أعِدِ المحاولة.",
      "tr": "Rakkoo tasaa mudateen kallattiin meeshaa dubbifamuu hin dandeenye. Irra deebi'ii yaali.",
      "translit": "",
      "tag": "machine",
      "src": {
        "name": "machine",
        "url": "",
        "rights": "",
        "date": ""
      },
      "source_paths": [
        {
          "file": "app.jsx",
          "pointer": "/line:33893"
        }
      ]
    },
    {
      "id": "h:69ca06ab0f39",
      "kind": "text",
      "ar": "أعِدِ المحاولة",
      "tr": "Irra deebi'ii yaali",
      "translit": "",
      "tag": "machine",
