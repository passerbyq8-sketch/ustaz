      }
    },
    {
      "id": "h:081d9bc2982a",
      "kind": "quran",
      "ar": "وَهُوَ مَعَكُمْ أَيْنَ مَا كُنتُمْ",
      "tr": "اوست كه آسمان‌ها و زمین را در شش روز آفرید؛ آنگاه [آن گونه كه شايسته جلال و مقام اوست] بر عرش قرار گرفت. هر چه در زمین نفوذ می‌كند یا از آن برمی‌آید و هر چه از آسمان فرود می‌آید یا در آن صعود می‌كند، [همه را] مى‌داند؛ و هر جا كه باشید، همراه شماست؛ و الله به آنچه مى‌كنید، بیناست.",
      "translit": "",
      "tag": "published",
      "src": {
        "name": "Persian Translation - Rowwad Translation Center",
        "url": "https://quranenc.com/en/browse/persian_ih",
        "rights": "Attributed reuse, see SOURCES",
        "date": "",
        "ref": "57:4"
      }
    },
