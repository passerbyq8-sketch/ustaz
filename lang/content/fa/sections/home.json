    {
      "id": "h:19636b5a750a",
      "kind": "quran",
      "ar": "فَٱذْكُرُونِىٓ أَذْكُرْكُمْ",
      "tr": "پس مرا یاد کنید تا شما را یاد کنم و شکر مرا به جای آورید و از من ناسپاسی نکنید.",
      "translit": "",
      "tag": "published",
