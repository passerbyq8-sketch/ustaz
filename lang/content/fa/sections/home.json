    {
      "id": "h:b10c7068d1c2",
      "kind": "quran",
      "ar": "إِنَّ مَعَ ٱلْعُسْرِ يُسْرًا",
      "tr": "[آری؛] مسلماً با [هر] دشواری، آسانی است.",
