    },
    {
      "id": "QIBLA_LOC_ASKING",
      "kind": "text",
      "ar": "يُطلَبُ الإذنُ بالموقع الآن…",
      "tr": "اکنون اجازهٔ دسترسی به موقعیت درخواست می‌شود…",
      "translit": "",
      "tag": "machine",
      "src": {
        "name": "machine",
        "url": "",
        "rights": "",
        "date": ""
      }
    },
    {
      "id": "QIBLA_LOC_DENIED",
      "kind": "text",
      "ar": "لم يُمنَحِ الإذنُ بالموقع، والموضعُ الافتراضيُّ باقٍ كما هو.",
      "tr": "اجازهٔ دسترسی به موقعیت داده نشد؛ موقعیت پیش‌فرض همچنان باقی است.",
      "translit": "",
      "tag": "machine",
      "src": {
        "name": "machine",
        "url": "",
        "rights": "",
        "date": ""
      }
    },
    {
      "id": "QIBLA_COMPASS_START",
      "kind": "text",
      "ar": "شغِّلِ البوصلة",
      "tr": "روشن‌کردن قطب‌نما",
      "translit": "",
      "tag": "machine",
      "src": {
        "name": "machine",
        "url": "",
        "rights": "",
        "date": ""
      }
    },
    {
      "id": "QIBLA_COMPASS_WAIT",
      "kind": "text",
      "ar": "بانتظارِ قراءةٍ من حسّاسِ الاتّجاه…",
      "tr": "در انتظار دریافت داده از حسگر جهت…",
      "translit": "",
      "tag": "machine",
      "src": {
        "name": "machine",
        "url": "",
        "rights": "",
        "date": ""
      }
    },
    {
      "id": "QIBLA_COMPASS_NONE",
      "kind": "text",
      "ar": "لا تدورُ البوصلةُ على هذا الجهاز: لم تصلْ قراءةٌ صالحةٌ من حسّاسِ الاتّجاه، فالدرجةُ وحدَها هي المعروضة.",
      "tr": "قطب‌نما روی این دستگاه نمی‌چرخد؛ دادهٔ معتبری از حسگر جهت دریافت نشد و فقط زاویه نمایش داده می‌شود.",
      "translit": "",
      "tag": "machine",
      "src": {
        "name": "machine",
        "url": "",
        "rights": "",
        "date": ""
      }
    },
    {
      "id": "QIBLA_COMPASS_LIVE",
      "kind": "text",
      "ar": "البوصلةُ تدورُ مع الجهاز.",
      "tr": "قطب‌نما همراه دستگاه می‌چرخد.",
      "translit": "",
      "tag": "machine",
      "src": {
        "name": "machine",
        "url": "",
        "rights": "",
        "date": ""
      }
    },
    {
      "id": "QIBLA_COMPASS_CALIBRATION",
      "kind": "text",
      "ar": "السهمُ يدورُ، لكنَّ معايرةَ حسّاسِ الاتّجاهِ ناقصة. حرِّكِ الجهازَ ببطءٍ على شكلِ الرقم ٨ حتّى تتحسّنَ المعايرة.",
      "tr": "عقربه می‌چرخد، اما حسگر جهت به‌خوبی تنظیم نشده است. دستگاه را به‌آرامی به شکل عدد ٨ حرکت دهید تا تنظیم آن بهتر شود.",
      "translit": "",
      "tag": "machine",
      "src": {
        "name": "machine",
        "url": "",
        "rights": "",
        "date": ""
      }
    },
    {
      "id": "QIBLA_COMPASS_SENSOR_UNAVAILABLE",
      "kind": "text",
      "ar": "لا يحتوي هذا الجهازُ على حسّاسِ اتّجاهٍ متاح؛ تبقى درجةُ القبلةِ المعروضةُ أعلاه.",
      "tr": "این دستگاه حسگر جهتِ در دسترس ندارد؛ زاویهٔ قبله که در بالا نمایش داده شده باقی می‌ماند.",
      "translit": "",
      "tag": "machine",
      "src": {
        "name": "machine",
        "url": "",
        "rights": "",
        "date": ""
      }
    },
    {
      "id": "QIBLA_COMPASS_PERMISSION_DENIED",
      "kind": "text",
      "ar": "إذنُ الموقعِ مرفوض. افتحْ إعداداتِ الجهازِ الخاصّةَ بتطبيقِ عزك وامنحْ إذنَ الموقع، ثم عُدْ إلى هذه الشاشة.",
      "tr": "اجازهٔ دسترسی به موقعیت رد شده است. تنظیمات دستگاه برای برنامهٔ عزک را باز کنید و اجازهٔ موقعیت را بدهید، سپس به این صفحه بازگردید.",
      "translit": "",
      "tag": "machine",
      "src": {
        "name": "machine",
        "url": "",
        "rights": "",
        "date": ""
      }
    },
    {
      "id": "QIBLA_COMPASS_HEADING_ERROR",
      "kind": "text",
      "ar": "تعذّرتْ قراءةُ اتّجاهِ الجهازِ بسببِ عطبٍ طارئ. أعِدِ المحاولة.",
      "tr": "به علت اشکالی ناگهانی، خواندن جهت دستگاه ممکن نشد. دوباره تلاش کنید.",
      "translit": "",
      "tag": "machine",
      "src": {
        "name": "machine",
        "url": "",
        "rights": "",
        "date": ""
      }
    },
